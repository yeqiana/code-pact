{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Pact V2 Evaluation Result",
  "type": "object",
  "required": ["case_id", "case_revision", "repo_fixture_revision", "model", "agent_runtime_version", "skill_revision", "executed_at", "run_count", "pass_count", "result", "evidence"],
  "properties": {
    "case_id": { "type": "string" },
    "case_revision": { "type": "integer", "minimum": 1 },
    "repo_fixture_revision": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "agent_runtime_version": { "type": "string", "minLength": 1 },
    "skill_revision": { "type": "string", "minLength": 1 },
    "executed_at": { "type": "string", "minLength": 1 },
    "run_count": { "type": "integer", "minimum": 1 },
    "pass_count": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["pass", "fail", "inconclusive"] },
    "failure_reason": { "type": ["string", "null"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}